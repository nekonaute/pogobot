Bootstrap: docker
From: ubuntu:20.04


%labels
    Author leo.cazenille@gmail.com
    Version 0.2.0

%files
    litex_version.txt /litex_version.txt

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Do not let packages from the host user's bind-mounted home shadow the
    # toolchain installed system-wide in the image.
    export PYTHONNOUSERSITE=1
    export PATH=$PATH:/pogobot/dependencies/litex/riscv64-unknown-elf-gcc-10.1.0-2020.08.2-x86_64-linux-ubuntu14/bin

%post
    export DEBIAN_FRONTEND=noninteractive
    export NPROC=$(  grep -i "^processor" /proc/cpuinfo | wc -l )

    apt-get update
    apt-get install -y wget python3 python3-dev python3-pip git
    apt-get -y install bison build-essential clang clang-format cmake flex gawk git graphviz libboost-all-dev libboost-dev libboost-filesystem-dev libboost-iostreams-dev libboost-program-options-dev libboost-python-dev libboost-system-dev libboost-thread-dev libeigen3-dev libffi-dev libftdi-dev libreadline-dev mercurial pkg-config python3 python3-dev python3-pip python3-setuptools qt5-default tcl-dev xdot zlib1g-dev
    pip3 install meson==0.64.1 ninja==1.11.1

    cd /
    git clone https://github.com/nekonaute/pogobot.git
    cd /pogobot
    mkdir -p dependencies

    # LiteX, Migen, LiteScope, CPU data and software data. Keep the directory
    # layout used by Software/readme.md: dependencies/litex is a container for
    # the ecosystem repositories, including a nested litex repository.
    mkdir -p /pogobot/dependencies/litex
    cd /pogobot/dependencies/litex
    wget -O litex_setup.py https://raw.githubusercontent.com/enjoy-digital/litex/3ab7eaa5f7afb4d432b5641d7761813d3274d25f/litex_setup.py
    chmod +x litex_setup.py

    # --dev prevents this pinned setup script from replacing itself with the
    # latest upstream version. In this LiteX revision it also selects SSH clone
    # URLs, so rewrite those URLs to HTTPS for unattended container builds.
    git config --global url."https://github.com/".insteadOf "git@github.com:"

    # Clone the standard LiteX ecosystem (including Migen and LiteScope), then
    # move every repository to the revision recorded next to this definition.
    ./litex_setup.py --dev --init --config standard
    cd /pogobot/dependencies/litex
    awk '{ if(!system("test -d " $1)) {system("git -C " $1 " checkout " $3)}}' /litex_version.txt

    # Install into the image's system site-packages. Do not use --user here:
    # Apptainer bind-mounts the invoking user's home at runtime, hiding root's
    # user site-packages and causing imports such as `import migen` to fail.
    cd /pogobot/dependencies/litex
    ./litex_setup.py --dev --install --config standard
    ./litex_setup.py --dev --gcc riscv

    python3 -c "import migen, litex, litescope"

    # icestorm
    cd /pogobot/dependencies
    git clone https://github.com/cliffordwolf/icestorm.git icestorm
    cd icestorm
    git checkout 2bc541743ada3542c6da36a50e66303b9cbd2059
    make -j${NPROC} 
    make install

    # yosys
    cd /pogobot/dependencies
    git clone https://github.com/YosysHQ/yosys
    cd yosys
    git checkout tags/yosys-0.18
    make -j${NPROC}
    make install

    # nextpnr
    cd /pogobot/dependencies
    git clone https://github.com/YosysHQ/nextpnr
    cd nextpnr
    git checkout 8d063d38b148b1e7095a032ffc9cf957c2407f32
    cmake . -DARCH=ice40
    make -j${NPROC}
    make install



%runscript
    echo "Nothing there yet..."

%apprun install_dep
    echo "Build dependencies are already installed in the container image."
    python3 -c "import migen, litex, litescope"


%apprun compile_sdk
    cd Software
    ./pogosoc.py --target=pogobotv3 --cpu-variant=lite --build
    cd sdk
    make



%apprun test_install
    python3 -c "import litex" && echo "LITEX: SUCCESS"
    python3 -c "import migen" && echo "MIGEN: SUCCESS"
    python3 -c "import litescope" && echo "LITESCOPE: SUCCESS"
    echo | yosys > /dev/null && echo "YOSYS: SUCCESS"
    icebox_diff > /dev/null && echo "ICESTORM: SUCCESS"
    nextpnr-ice40 --version 2> /dev/null && echo "NEXTPNR: SUCCESS"
    riscv64-unknown-elf-addr2line -v > /dev/null && echo "GCC toolchain: SUCCESS"
    

%apprun make
    make clean
    NPROC=$(  grep -i "^processor" /proc/cpuinfo | wc -l )
    exec make -j $NPROC

%apprun bash
    exec bash

%test
    python3 -c "import migen, litex, litescope"
    command -v yosys
    command -v icebox_diff
    command -v nextpnr-ice40
    command -v riscv64-unknown-elf-gcc
